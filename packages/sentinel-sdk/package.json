{
  "name": "@sentinelguard/sdk",
  "version": "0.1.0",
  "description": "Real-time on-chain exploit detection SDK for Solana DeFi",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "prepublishOnly": "bun run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": ["solana", "defi", "security", "exploit-detection", "circuit-breaker", "web3"],
  "author": "Rudra Prajapati",
  "license": "MIT",
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^6.0.3"
  }
}